# =============================================================================
# Commerce Insight AI — .gitignore
# Covers: Java/Maven, Node.js, React/Vite, Docker, IDE, OS
# =============================================================================

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE — IntelliJ IDEA ───────────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
out/

# ── IDE — VS Code ─────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# ── IDE — Eclipse ─────────────────────────────────────────────────────────────
.classpath
.project
.settings/
bin/

# ── Java / Maven ─────────────────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Maven wrapper
.mvn/

# ── Spring Boot ───────────────────────────────────────────────────────────────
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-secret.yml

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ── React / Vite ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
*.local
.cache/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Environment Variables ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Docker ────────────────────────────────────────────────────────────────────
docker/postgres/data/
docker/pgadmin/data/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── Coverage & Test Reports ───────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
surefire-reports/

# ── Build Artifacts ───────────────────────────────────────────────────────────
build/
*.tmp
*.bak
*.swp
*~.nib

# ── Misc ──────────────────────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
.grunt
.lock-wscript
