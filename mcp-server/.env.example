# =============================================================================
# MCP Server Environment Variables
# Copy to .env for local development — never commit .env
# =============================================================================

# Server port
PORT=3001

# Spring Boot backend API base URL
# The MCP server ONLY communicates with the backend, never the DB directly.
BACKEND_API_URL=http://localhost:8080/api

# API key for authenticating requests to the Spring Boot backend
# Must match the value configured in application-dev.yml
MCP_API_KEY=dev-mcp-key-changeme

# Logging level (debug | info | warn | error)
LOG_LEVEL=info
