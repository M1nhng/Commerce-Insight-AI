# Commerce Insight AI — Environment Variables Template
# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────
DB_NAME=commerce_insight
DB_USERNAME=postgres
DB_PASSWORD=change_me_in_production
DB_PORT=5432

# ── JWT ───────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use a random 64-char hex string in production.
JWT_SECRET=change-this-to-a-random-64-character-string-in-production-env
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=7

# ── MCP Server ────────────────────────────────────────────────────────────
MCP_API_KEY=change-this-mcp-api-key-in-production

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Spring Profile ────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Ports ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=5173
MCP_PORT=3001
PGADMIN_PORT=5050

# ── AI Provider ───────────────────────────────────────────────────────────
# Provide at least one API key. Used by the Spring Boot AI module.
OPENAI_API_KEY=sk-...your-openai-key...
ANTHROPIC_API_KEY=sk-ant-...your-claude-key...
GEMINI_API_KEY=...your-gemini-key...

# ── PgAdmin (dev-tools profile) ───────────────────────────────────────────
PGADMIN_EMAIL=admin@commerceinsight.ai
PGADMIN_PASSWORD=admin
