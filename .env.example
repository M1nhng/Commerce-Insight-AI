# Commerce Insight AI — Environment Variables Template
# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────
DB_NAME=commerce_insight
DB_USERNAME=postgres
DB_PASSWORD=change_me_in_production
DB_PORT=5432

# ── JWT ───────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use a random 64-char hex string in production.
JWT_SECRET=change-this-to-a-random-64-character-string-in-production-env
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=7

# ── MCP Server ────────────────────────────────────────────────────────────
MCP_API_KEY=change-this-mcp-api-key-in-production

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Spring Profile ────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Ports ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=5173
MCP_PORT=3001
PGADMIN_PORT=5050

# ── AI-assisted analytics (optional) ─────────────────────────────────────
# The "AI Business Insights" dashboard card + POST /api/v1/analytics/ai-insights
# + the MCP analytics_ai_insights tool. OFF by default: with AI_INSIGHTS_ENABLED
# unset/false (or no key) the app still starts and the card shows
# "temporarily unavailable" — nothing else is affected. Keys are read ONLY by
# the Spring Boot backend; they are NEVER exposed to the frontend or MCP.
AI_INSIGHTS_ENABLED=false
AI_PROVIDER=openai                       # openai | ollama | any OpenAI-compatible gateway
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1    # e.g. http://localhost:11434/v1 for Ollama
# AI_TIMEOUT_MS=20000
# AI_MAX_OUTPUT_TOKENS=900
# AI_TEMPERATURE=0.2

# Provide a key for the selected provider. Only OPENAI_API_KEY is wired to the
# built-in OpenAI-compatible provider today; the others are placeholders for
# future provider implementations. A local Ollama needs no key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── PgAdmin (dev-tools profile) ───────────────────────────────────────────
PGADMIN_EMAIL=admin@commerceinsight.ai
PGADMIN_PASSWORD=admin
